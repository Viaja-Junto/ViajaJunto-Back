    {
      "name": "Tourist Spots",
      "description": "Pontos turísticos. Leitura pública; qualquer usuário autenticado cadastra; só quem cadastrou altera ou apaga.",
      "item": [
        {
          "name": "List tourist spots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tourist-spots?page=1&limit=20&sort=name&q=parque&city=Porto Alegre&country=BR&category=PARK&minRating=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tourist-spots"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Página, a partir de 1"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Itens por página (máximo 100)"
                },
                {
                  "key": "sort",
                  "value": "name",
                  "description": "newest (padrão) | rating | name"
                },
                {
                  "key": "q",
                  "value": "parque",
                  "description": "Texto no nome",
                  "disabled": true
                },
                {
                  "key": "city",
                  "value": "Porto Alegre",
                  "description": "Cidade (exata, sem diferenciar maiúsculas)",
                  "disabled": true
                },
                {
                  "key": "country",
                  "value": "BR",
                  "description": "País ou código ISO",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "PARK",
                  "description": "NATURE | BEACH | PARK | MUSEUM | MONUMENT | HISTORICAL | ENTERTAINMENT | OTHER",
                  "disabled": true
                },
                {
                  "key": "minRating",
                  "value": "4",
                  "description": "Nota média mínima (1 a 5)",
                  "disabled": true
                }
              ]
            },
            "description": "Lista paginada `{ data, meta }`. Ative os filtros que quiser. Salva em `spotId` o primeiro ponto que **não** foi cadastrado por você (para poder avaliá-lo).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const me = pm.collectionVariables.get('userId');",
                  "const spot = pm.response.json().data.find((s) => s.createdBy !== me);",
                  "pm.test('há um ponto de outra pessoa para avaliar (rode o seed)', () => pm.expect(spot).to.exist);",
                  "if (spot) pm.collectionVariables.set('spotId', spot.id);"
                ]
              }
            }
          ]
        },
