# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_PATH=docs

# ─── Database ────────────────────────────────────────────────
# Must match the POSTGRES_* values below (docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viajajunto?schema=public"

# ─── Access tokens (JWT) ─────────────────────────────────────
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Token lifetime, in seconds.
JWT_EXPIRES_IN=3600

# ─── Google sign-in (optional) ───────────────────────────────
# OAuth client from Google Cloud Console > APIs & Services > Credentials.
# Without these the API starts and /auth/google answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an "Authorized redirect URI" of the client.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Frontend page that receives #access_token=... after the sign-in.
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ─── HTTP ────────────────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173
# Requests per IP in each window: reads, writes and sensitive routes.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
THROTTLE_WRITE_LIMIT=60
THROTTLE_STRICT_LIMIT=10
# Reverse proxies in front of the API (1 behind a load balancer).
TRUST_PROXY_HOPS=0

# ─── Photo storage (S3) ──────────────────────────────────────
# Optional: without S3_BUCKET the API starts and photo uploads answer 503.
# To use the MiniStack bucket while running npm run start:dev, after
# npm run aws:deploy (the deploy prints the bucket name):
#   S3_BUCKET=viajajunto-photos-000000000000
#   S3_ENDPOINT=http://localhost:4566
#   S3_FORCE_PATH_STYLE=true
#   AWS_ACCESS_KEY_ID=test
#   AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ─── Docker Compose (read only by docker-compose.yml) ────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viajajunto
POSTGRES_PORT=5432
API_PORT=3000
ADMINER_PORT=8080
