// ViajaJunto — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String    @map("password_hash")
  // Never set through the API: promote an account with `npm run user:make-admin`.
  role             UserRole  @default(USER)
  // Access tokens issued before this instant are refused: signing out ends every session.
  tokensValidAfter DateTime? @map("tokens_valid_after")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  touristSpots         TouristSpot[]  @relation("TouristSpotCreator")
  reviewedTouristSpots TouristSpot[]  @relation("TouristSpotReviewer")
  destinations         Destination[]  @relation("DestinationCreator")
  reviewedDestinations Destination[]  @relation("DestinationReviewer")
  reviews              Review[]
  notifications        Notification[] @relation("NotificationRecipient")
  notificationsCaused  Notification[] @relation("NotificationActor")

  @@map("user")
}

enum CatalogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DestinationCategory {
  CITY
  BEACH
  NATURE
  CULTURAL
}

// A city or region travellers go to (FR08-FR10). Suggested by users and
// published by an administrator.
model Destination {
  id              String               @id @default(uuid())
  name            String
  country         String
  // ISO 3166-1 alpha-2 ("BR"), so a map can colour the country directly.
  countryCode     String?              @map("country_code") @db.VarChar(2)
  category        DestinationCategory?
  description     String?
  latitude        Float?
  longitude       Float?
  photoUrl        String?              @map("photo_url")
  // Derived from the destination reviews, in the same transaction that changes them.
  averageRating   Float?               @map("average_rating")
  reviewCount     Int                  @default(0) @map("review_count")
  status          CatalogStatus        @default(PENDING)
  rejectionReason String?              @map("rejection_reason")
  createdBy       String?              @map("created_by")
  reviewedBy      String?              @map("reviewed_by")
  reviewedAt      DateTime?            @map("reviewed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  creator      User?         @relation("DestinationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  reviewer     User?         @relation("DestinationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  touristSpots TouristSpot[]

  @@unique([name, country])
  @@index([status])
  @@index([createdBy])
  @@map("destination")
}

enum SpotCategory {
  NATURE
  BEACH
  PARK
  MUSEUM
  MONUMENT
  HISTORICAL
  ENTERTAINMENT
  OTHER
}

model TouristSpot {
  id              String        @id @default(uuid())
  name            String
  description     String?
  category        SpotCategory  @default(OTHER)
  address         String?
  city            String
  state           String?
  country         String
  // ISO 3166-1 alpha-2 ("BR"), so a map can colour the country directly.
  countryCode     String?       @map("country_code") @db.VarChar(2)
  latitude        Float?
  longitude       Float?
  photoUrl        String?       @map("photo_url")
  // Derived from the reviews, in the same transaction that changes them.
  averageRating   Float?        @map("average_rating")
  reviewCount     Int           @default(0) @map("review_count")
  status          CatalogStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  // Who suggested it; null once that account is deleted, so the catalog keeps the place.
  createdBy       String?       @map("created_by")
  reviewedBy      String?       @map("reviewed_by")
  reviewedAt      DateTime?     @map("reviewed_at")
  // The destination (city) the spot is in, when known.
  destinationId   String?       @map("destination_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  creator     User?        @relation("TouristSpotCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  reviewer    User?        @relation("TouristSpotReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  reviews     Review[]

  @@unique([name, city, country])
  @@index([city])
  @@index([category])
  @@index([createdBy])
  @@index([status])
  @@index([destinationId])
  @@map("tourist_spot")
}

model Review {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  touristSpotId String    @map("tourist_spot_id")
  rating        Int
  comment       String?
  visitedAt     DateTime? @map("visited_at") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  touristSpot TouristSpot @relation(fields: [touristSpotId], references: [id], onDelete: Cascade)

  @@unique([userId, touristSpotId])
  @@index([touristSpotId])
  @@map("review")
}

enum NotificationType {
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
}

// Something the user is told about in the app (FR21).
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  // The trip it happened on; null for notifications about the catalogs.
  tripId    String?          @map("trip_id")
  // Who did it; kept as null if they delete their account.
  actorId   String?          @map("actor_id")
  type      NotificationType
  // Small and flat: names and ids the client needs to say what happened.
  payload   Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}
